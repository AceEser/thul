# Copy this file to ".env" and edit as needed. All values are optional.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Full path to the folder containing ffmpeg.exe if it is not on PATH, e.g. C:\ffmpeg\bin
FFMPEG_LOCATION=
MAX_IMAGE_MB=15
MAX_PDF_MB=30
MAX_DOWNLOAD_MB=1000
MAX_VIDEO_MINUTES=120
MAX_CONCURRENT_DOWNLOADS=2
FILE_TTL_MINUTES=20
